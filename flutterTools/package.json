{
  "name": "flutter-tools",
  "displayName": "flutterTools",
  "description": "flutter tools",
  "version": "0.0.13",
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
  "onLanguage:dart"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "flutterTools.selectCurrentWidget",
        "title": "Flutter Tools: Select Current Widget"
      },
      {
        "command": "flutterTools.generateConstructorParams",
        "title": "Flutter Tools: Generate Constructor Parameters"
      },
      {
        "command": "flutterTools.generateGetXModule",
        "title": "Flutter Tools: Generate GetX Module"
      },
      {
        "command": "flutterTools.extractWidgetToFile",
        "title": "Flutter Tools: Extract Widget to File (Stateless)"
      },
      {
        "command": "flutterTools.wrapWithObx",
        "title": "Flutter Tools: Wrap with Obx"
      },
      {
        "command": "flutterTools.wrapWithObxBlock",
        "title": "Flutter Tools: Wrap with Obx (Block)"
      },
      {
        "command": "flutterTools.wrapWithFutureBuilder",
        "title": "Flutter Tools: Wrap with FutureBuilder"
      },
      {
        "command": "flutterTools.wrapWithLayoutBuilder",
        "title": "Flutter Tools: Wrap with LayoutBuilder"
      },
      {
        "command": "flutterTools.wrapWithGetBuilder",
        "title": "Flutter Tools: Wrap with GetBuilder"
      },
      {
        "command": "flutterTools.removeObxParent",
        "title": "Flutter Tools: Remove Obx Parent"
      },
      {
        "command": "flutterTools.removeGetBuilderParent",
        "title": "Flutter Tools: Remove GetBuilder Parent"
      },
      {
        "command": "flutterTools.watchVariableAccess",
        "title": "Flutter Tools: Watch Variable Access..."
      },
      {
        "command": "flutterTools.watchVariableReads",
        "title": "Flutter Tools: Watch Variable Reads"
      },
      {
        "command": "flutterTools.watchVariableWrites",
        "title": "Flutter Tools: Watch Variable Writes"
      },
      {
        "command": "flutterTools.watchVariableReadsAndWrites",
        "title": "Flutter Tools: Watch Variable Reads and Writes"
      },
      {
        "command": "flutterTools.breakOnRxValueWrites",
        "title": "Flutter Tools: Break on Rx .value Writes"
      },
      {
        "command": "flutterTools.removeVariableWatch",
        "title": "Flutter Tools: Remove Variable Watch"
      },
      {
        "command": "flutterTools.clearVariableWatchBreakpoints",
        "title": "Flutter Tools: Clear Variable Watch Breakpoints"
      },
      {
        "command": "flutterTools.selectCurrentFunction",
        "title": "Flutter Tools: Select Current Function"
      },
      {
        "command": "flutterTools.generateOverrideMethods",
        "title": "Flutter Tools: Generate Override Methods"
	  },
	  {
		"command": "flutterTools.renameFileToSnakeCase",
		"title": "Flutter Tools: Rename File to snake_case"
    },
    {
    "command": "flutterTools.searchFiles",
    "title": "Flutter Tools: Search Files"
      }
    ],
    "menus": {
    "explorer/context": [
        {
          "command": "flutterTools.generateGetXModule",
          "when": "explorerResourceIsFolder",
          "group": "navigation"
		},
		{
		  "command": "flutterTools.renameFileToSnakeCase",
      "when": "explorerResourceIsFolder",
      "group": "navigation"
    },
    {
      "command": "flutterTools.renameFileToSnakeCase",
      "when": "!explorerResourceIsFolder && resourceScheme == file",
		  "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Flutter Tools",
      "properties": {
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/node-fetch": "^2.6.12",
    "@types/vscode": "^1.101.0",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.3",
    "eslint": "^9.25.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "change-case": "^5.4.4",
    "marked": "^16.0.0",
    "node-fetch": "^2.7.0"
  }
}
